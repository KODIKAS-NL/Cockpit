{
  "name": "cockpit-claude-code-daemon",
  "displayName": "Cockpit for Claude Code Daemon",
  "description": "%ext.description%",
  "icon": "media/icon.png",
  "version": "1.0.265",
  "publisher": "KODIKAS",
  "license": "MIT",
  "author": {
    "name": "Tootega Pesquisa e Inovação",
    "url": "https://github.com/HermesSilva/Cockpit"
  },
  "contributors": [
    {
      "name": "Jeroen Versteege",
      "url": "https://github.com/KODIKAS-NL"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KODIKAS-NL/Cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/KODIKAS-NL/Cockpit/issues"
  },
  "homepage": "https://github.com/KODIKAS-NL/Cockpit#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "anthropic"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:cockpitDaemon.cockpit.editor",
    "onView:cockpitDaemon.hub",
    "onView:cockpitDaemon.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cockpitDaemon.open",
        "title": "%cmd.open%",
        "category": "Cockpit Daemon",
        "icon": "$(sparkle)"
      },
      {
        "command": "cockpitDaemon.newSession",
        "title": "%cmd.newSession%",
        "category": "Cockpit Daemon",
        "icon": "$(add)"
      },
      {
        "command": "cockpitDaemon.interrupt",
        "title": "%cmd.interrupt%",
        "category": "Cockpit Daemon",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cockpitDaemon.openSessions",
        "title": "%cmd.openSessions%",
        "category": "Cockpit Daemon",
        "icon": "$(history)"
      },
      {
        "command": "cockpitDaemon.settings",
        "title": "%cmd.settings%",
        "category": "Cockpit Daemon",
        "icon": "$(gear)"
      },
      {
        "command": "cockpitDaemon.openInEditor",
        "title": "%cmd.openInEditor%",
        "category": "Cockpit Daemon",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "cockpitDaemon.reloadView",
        "title": "%cmd.reloadView%",
        "category": "Cockpit Daemon",
        "icon": "$(refresh)"
      },
      {
        "command": "cockpitDaemon.reopenClosed",
        "title": "%cmd.reopenClosed%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.login",
        "title": "%cmd.login%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.logout",
        "title": "%cmd.logout%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.toggleLanguage",
        "title": "%cmd.toggleLanguage%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.setApiKey",
        "title": "%cmd.setApiKey%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.clearApiKey",
        "title": "%cmd.clearApiKey%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.enableUsageTracking",
        "title": "%cmd.enableUsageTracking%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.disableUsageTracking",
        "title": "%cmd.disableUsageTracking%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.enableUtf8Fix",
        "title": "%cmd.enableUtf8Fix%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.disableUtf8Fix",
        "title": "%cmd.disableUtf8Fix%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.daemon.install",
        "title": "%cmd.daemonInstall%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.daemon.restart",
        "title": "%cmd.daemonRestart%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.daemon.stop",
        "title": "%cmd.daemonStop%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.daemon.uninstall",
        "title": "%cmd.daemonUninstall%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.daemon.showLog",
        "title": "%cmd.daemonShowLog%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.daemon.stopSession",
        "title": "%cmd.daemonStopSession%",
        "category": "Cockpit Daemon"
      },
      {
        "command": "cockpitDaemon.openInSidebar",
        "title": "%cmd.openInSidebar%",
        "category": "Cockpit Daemon",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cockpitDaemon.open",
          "group": "navigation@0",
          "when": "!cockpitDaemon.cockpitActive"
        },
        {
          "command": "cockpitDaemon.reloadView",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "cockpitDaemon.newSession",
          "group": "navigation@0",
          "when": "view == cockpitDaemon.chat"
        },
        {
          "command": "cockpitDaemon.openInEditor",
          "group": "navigation@1",
          "when": "view == cockpitDaemon.chat"
        },
        {
          "command": "cockpitDaemon.settings",
          "group": "navigation@2",
          "when": "view == cockpitDaemon.chat"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cockpitDaemon",
          "title": "Cockpit for Claude Code Daemon",
          "icon": "media/icon.svg"
        },
        {
          "id": "cockpitDaemon-chat-fallback",
          "title": "Cockpit for Claude Code Daemon",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "cockpitDaemon-chat",
          "title": "Cockpit for Claude Code Daemon",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cockpitDaemon": [
        {
          "id": "cockpitDaemon.hub",
          "name": "%view.cockpit.name%",
          "type": "webview"
        }
      ],
      "cockpitDaemon-chat": [
        {
          "id": "cockpitDaemon.chat",
          "name": "Cockpit for Claude Code Daemon",
          "type": "webview",
          "when": "!cockpitDaemon.noSecondarySidebar"
        }
      ],
      "cockpitDaemon-chat-fallback": [
        {
          "id": "cockpitDaemon.chat",
          "name": "Cockpit for Claude Code Daemon",
          "type": "webview",
          "when": "cockpitDaemon.noSecondarySidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cockpitDaemon.open",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "cockpitDaemon.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "activeWebviewPanelId == cockpitDaemon.cockpit.editor || cockpitDaemon.sideBarActive"
      },
      {
        "command": "cockpitDaemon.reopenClosed",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "cockpitDaemon.cockpitActive || cockpitDaemon.sideBarActive"
      },
      {
        "command": "cockpitDaemon.interrupt",
        "key": "ctrl+alt+period",
        "mac": "cmd+alt+period"
      }
    ],
    "configuration": {
      "title": "Cockpit for Claude Code Daemon",
      "properties": {
        "cockpitDaemon.tootegaEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.tootegaEnabled%"
        },
        "cockpitDaemon.engine": {
          "type": "string",
          "enum": [
            "claude",
            "tootega"
          ],
          "enumDescriptions": [
            "%cfg.engine.claude%",
            "%cfg.engine.tootega%"
          ],
          "default": "claude",
          "description": "%cfg.engine%"
        },
        "cockpitDaemon.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "%cfg.claudePath%"
        },
        "cockpitDaemon.tootegaPath": {
          "type": "string",
          "default": "agent.exe",
          "description": "%cfg.tootegaPath%"
        },
        "cockpitDaemon.tootegaServer": {
          "type": "string",
          "default": "127.0.0.1:8080",
          "description": "%cfg.tootegaServer%"
        },
        "cockpitDaemon.language": {
          "type": "string",
          "enum": [
            "auto",
            "pt-BR",
            "en"
          ],
          "default": "auto",
          "description": "%cfg.language%"
        },
        "cockpitDaemon.model": {
          "type": "string",
          "default": "default",
          "description": "%cfg.model%"
        },
        "cockpitDaemon.effort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "CLI default (effortLevel from ~/.claude/settings.json)",
            "Low",
            "Medium",
            "High",
            "X-High",
            "Max"
          ],
          "default": "default",
          "description": "%cfg.effort%"
        },
        "cockpitDaemon.autoResumeLastSession": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoResumeLastSession%"
        },
        "cockpitDaemon.autosave": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autosave%"
        },
        "cockpitDaemon.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "plan",
            "acceptEdits",
            "auto",
            "dontAsk",
            "bypassPermissions"
          ],
          "default": "default",
          "description": "%cfg.permissionMode%"
        },
        "cockpitDaemon.allowAgents": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.allowAgents%"
        },
        "cockpitDaemon.enableTodoTools": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.enableTodoTools%"
        },
        "cockpitDaemon.notifyOnComplete": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifyOnComplete%"
        },
        "cockpitDaemon.showThinking": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.showThinking%"
        },
        "cockpitDaemon.spellCheck": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.spellCheck%"
        },
        "cockpitDaemon.expandToolCards": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.expandToolCards%"
        },
        "cockpitDaemon.verbosity": {
          "type": "string",
          "default": "verbose",
          "enum": [
            "verbose",
            "necessary",
            "dialogo",
            "quiet"
          ],
          "enumDescriptions": [
            "Verbose: everything (as today)",
            "Necessary: only edits and final explanations",
            "Dialogo: only edits and what it's doing",
            "Quiet: only final explanations"
          ],
          "description": "%cfg.verbosity%"
        },
        "cockpitDaemon.userName": {
          "type": "string",
          "default": "",
          "description": "%cfg.userName%"
        },
        "cockpitDaemon.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.ffmpegPath%"
        },
        "cockpitDaemon.internalModel": {
          "type": "string",
          "default": "claude-haiku-4-5",
          "enum": [
            "claude-haiku-4-5",
            "claude-sonnet-5-5",
            "claude-sonnet-4-6",
            "claude-sonnet-4-5",
            "claude-opus-4-6",
            "claude-fable-5"
          ],
          "enumDescriptions": [
            "Claude Haiku 4.5 (fast, cheap — recommended)",
            "Claude Sonnet 5.5",
            "Claude Sonnet 4.6",
            "Claude Sonnet 4.5",
            "Claude Opus 4.6",
            "Claude Fable 5"
          ],
          "description": "%cfg.internalModel%"
        },
        "cockpitDaemon.voiceCorrect": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.voiceCorrect%"
        },
        "cockpitDaemon.debugLog": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.debugLog%"
        },
        "cockpitDaemon.otel.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.otelEnabled%"
        },
        "cockpitDaemon.voiceLanguage": {
          "type": "string",
          "enum": [
            "",
            "pt",
            "en",
            "es",
            "fr",
            "de",
            "it",
            "ja",
            "ko",
            "ru",
            "nl",
            "pl",
            "tr",
            "uk",
            "hi",
            "id",
            "cs",
            "da",
            "el",
            "no",
            "sv"
          ],
          "default": "",
          "description": "%cfg.voiceLanguage%"
        },
        "cockpitDaemon.systemPrompt.quiet": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "IMPORTANT — output discipline (this overrides any default instruction to summarize or explain your work): Work silently. Do not narrate the task while doing it: no preamble, no \"I will now…\", no play-by-play between tool calls, no \"let me…\". When the work is finished, state ONLY that it is finished — a single short sentence such as \"Done.\" Do NOT produce a closing report, a summary, a bulleted list of changes, or a restatement of what the files or edits contain. The user can see the changes; repeating them is exactly what this rule forbids. This rule governs the shape of every response. Answer direct questions normally; this is about narration and closing reports, not about replying to the user.",
          "description": "%cfg.systemPromptQuiet%"
        },
        "cockpitDaemon.systemPrompt.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.systemPromptEnabled%"
        },
        "cockpitDaemon.systemPrompt.text": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "- **SHELL: TRÊS INTERPRETADORES, ESCOLHA BINÁRIA E EXPLÍCITA (diretiva-raiz, binária, soberana\n  sobre execução de comando).** Esta máquina tem os shells abaixo; o mesmo comando pode ser\n  válido em um e lixo em outro. Antes de emitir QUALQUER comando, saiba em QUAL shell ele roda e\n  escreva a sintaxe E o caminho daquele shell.\n\n  | Shell | Quando | Projeto | Temp | Heredoc |\n  |-------|--------|---------|------|---------|\n  | ${defaultShell} (DEFAULT) | tudo, salvo exceção | ${projectPathWin} | $env:TEMP | não |\n  | Git Bash (bash tool) | POSIX pontual | ${projectPathGitBash} | /tmp (pasta do Git) | ok |\n  ${wslRow}\n\n  Default = ${defaultShell}. Sai do default só quando a tarefa EXIGE POSIX (Git Bash) ou Linux\n  real (WSL), e a escolha é declarada, nunca implícita.\n\n  NUNCA CRUZAR sintaxe de um shell com caminho de outro: heredoc e paths POSIX (/tmp, /mnt/...)\n  só em Git Bash/WSL; paths ${winPathStyle} e $env:TEMP só no PowerShell. Foi o defeito a evitar\n  (`<<'EOF'` + /tmp no PowerShell -> C:\\tmp -> quebrou).\n\n  PowerShell ${psVersion}: sem heredoc, sem /tmp; temp = $env:TEMP; script multi-linha grava\n  arquivo (.ps1/.js/.py) e executa o arquivo (funciona igual nos três); UTF-8 explícito (5.1 tem\n  default ANSI e corrompe acento). Na dúvida, assuma o default e declare o shell se precisar de POSIX.",
          "description": "%cfg.systemPromptText%"
        },
        "cockpitDaemon.daemon.socketPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.daemonSocketPath%"
        },
        "cockpitDaemon.daemon.idleStopHours": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%cfg.daemonIdleStopHours%"
        },
        "cockpitDaemon.thinking": {
          "type": "string",
          "enum": [
            "cli",
            "off"
          ],
          "default": "cli",
          "enumDescriptions": [
            "%cfg.thinking.cli%",
            "%cfg.thinking.off%"
          ],
          "description": "%cfg.thinking%"
        },
        "cockpitDaemon.preferredLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "%cfg.preferredLocation.sidebar%",
            "%cfg.preferredLocation.editor%"
          ],
          "default": "sidebar",
          "description": "%cfg.preferredLocation%"
        },
        "cockpitDaemon.autoCompact": {
          "type": "string",
          "default": "auto",
          "description": "%cfg.autoCompact%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "gen-icon": "node scripts/gen-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "npm run clean && npm version patch --no-git-tag-version && vsce package",
    "vsix": "npm run typecheck && npm run clean && npm version patch --no-git-tag-version && vsce package"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "dictionary-en": "^4.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-pt-br": "^2.0.1",
    "highlight.js": "^11.9.0",
    "hunspell-asm": "^4.0.2",
    "nspell": "^2.1.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  }
}
