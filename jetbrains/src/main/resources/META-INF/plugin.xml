<idea-plugin>
  <id>nl.kodikas.cockpit</id>
  <name>Cockpit for Claude Code</name>
  <vendor url="https://github.com/KODIKAS-NL/Cockpit">KODIKAS</vendor>
  <description>Chat with Claude Code in the IDE, with conversations that outlive the window.</description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.jcef</depends>
  <depends>org.jetbrains.plugins.terminal</depends>

  <content>
    <module name="cockpit.shared" loading="required"/>
    <module name="cockpit.frontend"/>
    <module name="cockpit.backend"/>
  </content>
</idea-plugin>
